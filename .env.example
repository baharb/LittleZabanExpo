# Copy this file to ".env" and fill in your real Supabase project values
# (Project Settings -> API in the Supabase dashboard). These are safe to
# ship in the app bundle -- the anon key is meant to be public, it only
# grants what your Row Level Security / Auth rules allow.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
